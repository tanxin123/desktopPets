<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spider.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/spider.png" ToolTipText="桌面宠物">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="蜘蛛" ToggleType="Radio" Click="OnPickSpider" />
                        <NativeMenuItem Header="蟑螂" ToggleType="Radio" Click="OnPickRoach" />
                        <NativeMenuItem Header="甲虫" ToggleType="Radio" Click="OnPickBeetle" />
                        <NativeMenuItem Header="蚂蚁" ToggleType="Radio" Click="OnPickAnt" />
                        <NativeMenuItem Header="蜈蚣" ToggleType="Radio" Click="OnPickCentipede" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="启用喂食" ToggleType="CheckBox" Click="OnToggleFeeding" />
                        <NativeMenuItem Header="全屏时自动隐藏" ToggleType="CheckBox" Click="OnToggleAutoHide" />
                        <NativeMenuItem Header="跟随鼠标" ToggleType="CheckBox" Click="OnToggleFollow" />
                        <NativeMenuItem Header="开机自启" ToggleType="CheckBox" Click="OnToggleAutoStart" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="退出" Click="OnExitClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>