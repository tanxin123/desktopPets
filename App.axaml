<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spider.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/spider.png" ToolTipText="桌面宠物">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="蜘蛛" ToggleType="Radio" Click="OnPickSpider" />
                        <NativeMenuItem Header="蟑螂" ToggleType="Radio" Click="OnPickRoach" />
                        <NativeMenuItem Header="甲虫" ToggleType="Radio" Click="OnPickBeetle" />
                        <NativeMenuItem Header="蚂蚁" ToggleType="Radio" Click="OnPickAnt" />
                        <NativeMenuItem Header="蜈蚣" ToggleType="Radio" Click="OnPickCentipede" />
                        <NativeMenuItem Header="瓢虫" ToggleType="Radio" Click="OnPickLadybug" />
                        <NativeMenuItem Header="自定义" ToggleType="Radio" Click="OnPickCustom" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="宠物大小">
                            <NativeMenu>
                                <NativeMenuItem Header="小" ToggleType="Radio" Click="OnPickSize" />
                                <NativeMenuItem Header="中" ToggleType="Radio" Click="OnPickSize" />
                                <NativeMenuItem Header="大" ToggleType="Radio" Click="OnPickSize" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="移动速度">
                            <NativeMenu>
                                <NativeMenuItem Header="慢速" ToggleType="Radio" Click="OnPickSpeed" />
                                <NativeMenuItem Header="正常" ToggleType="Radio" Click="OnPickSpeed" />
                                <NativeMenuItem Header="快速" ToggleType="Radio" Click="OnPickSpeed" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="活动范围">
                            <NativeMenu>
                                <NativeMenuItem Header="所有显示器" ToggleType="Radio" Click="OnPickMonitor" />
                                <NativeMenuItem Header="显示器 1" ToggleType="Radio" Click="OnPickMonitor" />
                                <NativeMenuItem Header="显示器 2" ToggleType="Radio" Click="OnPickMonitor" />
                                <NativeMenuItem Header="显示器 3" ToggleType="Radio" Click="OnPickMonitor" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="退出快捷键">
                            <NativeMenu>
                                <NativeMenuItem Header="Ctrl+Shift+Q" ToggleType="Radio" Click="OnPickHotkey" />
                                <NativeMenuItem Header="Ctrl+Shift+X" ToggleType="Radio" Click="OnPickHotkey" />
                                <NativeMenuItem Header="Ctrl+Alt+Q" ToggleType="Radio" Click="OnPickHotkey" />
                                <NativeMenuItem Header="Ctrl+Shift+F12" ToggleType="Radio" Click="OnPickHotkey" />
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="启用喂食" ToggleType="CheckBox" Click="OnToggleFeeding" />
                        <NativeMenuItem Header="全屏时自动隐藏" ToggleType="CheckBox" Click="OnToggleAutoHide" />
                        <NativeMenuItem Header="跟随鼠标" ToggleType="CheckBox" Click="OnToggleFollow" />
                        <NativeMenuItem Header="开机自启" ToggleType="CheckBox" Click="OnToggleAutoStart" />
                        <NativeMenuItem Header="音效" ToggleType="CheckBox" Click="OnToggleSound" />
                        <NativeMenuItem Header="自动检查更新" ToggleType="CheckBox" Click="OnToggleAutoUpdate" />
                        <NativeMenuItem Header="检查更新" Click="OnCheckUpdate" />
                        <NativeMenuItem Header="设置…" Click="OnOpenSettings" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="退出" Click="OnExitClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
