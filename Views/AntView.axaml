<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spider.Views.AntView"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <RadialGradientBrush x:Key="AnShell" Center="50%,35%" GradientOrigin="40%,25%" RadiusX="80%" RadiusY="80%">
            <GradientStop Color="#4A2216" Offset="0" />
            <GradientStop Color="#2A120A" Offset="0.6" />
            <GradientStop Color="#120704" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Line.an-leg"><Setter Property="StrokeLineCap" Value="Round" /></Style>
        <Style Selector="Line.an-a"><Setter Property="StrokeThickness" Value="2.8" /><Setter Property="Stroke" Value="#2A120A" /></Style>
        <Style Selector="Line.an-b"><Setter Property="StrokeThickness" Value="2.4" /><Setter Property="Stroke" Value="#26100A" /></Style>
        <Style Selector="Line.an-c"><Setter Property="StrokeThickness" Value="1.9" /><Setter Property="Stroke" Value="#200D08" /></Style>
        <Style Selector="Line.an-d"><Setter Property="StrokeThickness" Value="1.3" /><Setter Property="Stroke" Value="#160906" /></Style>
    </UserControl.Styles>

    <Canvas>
        <!-- 6 条腿：L1~L3 左侧，R1~R3 右侧，每条 4 段（细长） -->
        <Canvas>
            <Line x:Name="L1a" Classes="an-leg an-a" /><Line x:Name="L1b" Classes="an-leg an-b" /><Line x:Name="L1c" Classes="an-leg an-c" /><Line x:Name="L1d" Classes="an-leg an-d" />
            <Line x:Name="L2a" Classes="an-leg an-a" /><Line x:Name="L2b" Classes="an-leg an-b" /><Line x:Name="L2c" Classes="an-leg an-c" /><Line x:Name="L2d" Classes="an-leg an-d" />
            <Line x:Name="L3a" Classes="an-leg an-a" /><Line x:Name="L3b" Classes="an-leg an-b" /><Line x:Name="L3c" Classes="an-leg an-c" /><Line x:Name="L3d" Classes="an-leg an-d" />
            <Line x:Name="R1a" Classes="an-leg an-a" /><Line x:Name="R1b" Classes="an-leg an-b" /><Line x:Name="R1c" Classes="an-leg an-c" /><Line x:Name="R1d" Classes="an-leg an-d" />
            <Line x:Name="R2a" Classes="an-leg an-a" /><Line x:Name="R2b" Classes="an-leg an-b" /><Line x:Name="R2c" Classes="an-leg an-c" /><Line x:Name="R2d" Classes="an-leg an-d" />
            <Line x:Name="R3a" Classes="an-leg an-a" /><Line x:Name="R3b" Classes="an-leg an-b" /><Line x:Name="R3c" Classes="an-leg an-c" /><Line x:Name="R3d" Classes="an-leg an-d" />
        </Canvas>

        <!-- 身体：原点 = 胸部中心，头朝 -Y；按屏幕像素直接绘制（缩放 1） -->
        <Canvas x:Name="BodyRoot" Width="0" Height="0">
            <!-- 触角（带肘）：零尺寸 Canvas，旋转它即绕根部摆动 -->
            <Canvas x:Name="AntL" Canvas.Left="-4" Canvas.Top="-42" Width="0" Height="0">
                <Path Stroke="#1A0A05" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Data="M 0,0 L -4,-14 L -16,-26" />
            </Canvas>
            <Canvas x:Name="AntR" Canvas.Left="4" Canvas.Top="-42" Width="0" Height="0">
                <Path Stroke="#1A0A05" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Data="M 0,0 L 4,-14 L 16,-26" />
            </Canvas>
            <!-- 腹部（后腹） -->
            <Ellipse Canvas.Left="-13" Canvas.Top="10" Width="26" Height="40" Fill="{StaticResource AnShell}" Stroke="#0A0402" StrokeThickness="1.2" />
            <Path Stroke="#0A0402" StrokeThickness="0.9" Opacity="0.6" Data="M -11,24 Q 0,28 11,24 M -10,36 Q 0,40 10,36" />
            <!-- 腰节 -->
            <Ellipse Canvas.Left="-3" Canvas.Top="4" Width="6" Height="9" Fill="#1A0A05" />
            <!-- 胸部 -->
            <Ellipse Canvas.Left="-7" Canvas.Top="-24" Width="14" Height="30" Fill="{StaticResource AnShell}" Stroke="#0A0402" StrokeThickness="1.2" />
            <!-- 大颚 -->
            <Path Stroke="#0A0402" StrokeThickness="1.6" StrokeLineCap="Round" Data="M -4,-44 L -6,-51 M 4,-44 L 6,-51" />
            <!-- 头 -->
            <Ellipse Canvas.Left="-9" Canvas.Top="-44" Width="18" Height="22" Fill="{StaticResource AnShell}" Stroke="#0A0402" StrokeThickness="1.2" />
            <Ellipse Canvas.Left="-8" Canvas.Top="-38" Width="4" Height="5" Fill="#030100" />
            <Ellipse Canvas.Left="4" Canvas.Top="-38" Width="4" Height="5" Fill="#030100" />
        </Canvas>
    </Canvas>
</UserControl>
