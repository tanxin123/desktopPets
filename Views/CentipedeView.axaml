<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Spider.Views.CentipedeView"
             IsHitTestVisible="False">

    <UserControl.Styles>
        <Style Selector="Line.cp-leg"><Setter Property="StrokeLineCap" Value="Round" /></Style>
        <Style Selector="Line.cp-a"><Setter Property="StrokeThickness" Value="3" /><Setter Property="Stroke" Value="#3E2C14" /></Style>
        <Style Selector="Line.cp-b"><Setter Property="StrokeThickness" Value="2.6" /><Setter Property="Stroke" Value="#38280F" /></Style>
        <Style Selector="Line.cp-c"><Setter Property="StrokeThickness" Value="2" /><Setter Property="Stroke" Value="#30220E" /></Style>
        <Style Selector="Line.cp-d"><Setter Property="StrokeThickness" Value="1.4" /><Setter Property="Stroke" Value="#241808" /></Style>
    </UserControl.Styles>

    <Canvas>
        <!-- 腿由代码生成：每个体节一对，每条 4 段，顺序：左侧（头到尾），再右侧 -->
        <Canvas x:Name="LegLayer" />

        <!-- 体节由代码生成，每个体节是一个独立的零尺寸 Canvas，按世界坐标定位并单独旋转，所以身体可以弯曲 -->
        <Canvas x:Name="SegLayer" />

        <!-- 头：原点 = 头与第 1 体节之间的颈部，头朝 -Y -->
        <Canvas x:Name="BodyRoot" Width="0" Height="0">
            <Canvas x:Name="AntL" Canvas.Left="-8" Canvas.Top="-24" Width="0" Height="0">
                <Path Stroke="#2A160A" StrokeThickness="1.6" StrokeLineCap="Round" Data="M 0,0 Q -14,-16 -30,-26" />
            </Canvas>
            <Canvas x:Name="AntR" Canvas.Left="8" Canvas.Top="-24" Width="0" Height="0">
                <Path Stroke="#2A160A" StrokeThickness="1.6" StrokeLineCap="Round" Data="M 0,0 Q 14,-16 30,-26" />
            </Canvas>
            <!-- 颚肢（毒颚） -->
            <Path Stroke="#140804" StrokeThickness="3" StrokeLineCap="Round" Data="M -7,-24 Q -13,-36 -4,-42 M 7,-24 Q 13,-36 4,-42" />
            <!-- 头板 -->
            <Ellipse Canvas.Left="-15" Canvas.Top="-26" Width="30" Height="30" Fill="#3A140C" Stroke="#0E0502" StrokeThickness="1.2" />
            <Ellipse Canvas.Left="-8" Canvas.Top="-18" Width="3" Height="3" Fill="#030100" />
            <Ellipse Canvas.Left="5" Canvas.Top="-18" Width="3" Height="3" Fill="#030100" />
        </Canvas>
    </Canvas>
</UserControl>
